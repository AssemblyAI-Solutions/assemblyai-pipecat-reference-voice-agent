# AssemblyAI: speech-to-text, LLM Gateway and text-to-speech all use this one key.
# Get it at https://www.assemblyai.com/dashboard/api-keys
ASSEMBLYAI_API_KEY=

# Daily: only needed to run in a Daily room (`uv run src/bot.py -t daily`).
# Get it at https://dashboard.daily.co/developers
DAILY_API_KEY=

# Twilio needs no key here: `uv run src/bot.py -t twilio -x <your-ngrok-host>` serves the
# Media Streams WebSocket, and your Twilio number's TwiML points at it.
